_vercel() {
  local curcontext="$curcontext" state line ret=1
  typeset -A opt_args

  _arguments -C \
    '(-h --help)'{-h,--help}'[Output usage information]' \
    '(-v --version)'{-v,--version}'[Output the version number]' \
    '--cwd=[Current working directory]:directory:_files -/' \
    '(-A --local-config)'{-A+,--local-config=}'[Path to the local vercel.json file]:file:_files -g "*.json"' \
    '(-Q --global-config)'{-Q+,--global-config=}'[Path to the global .vercel directory]:directory:_files -/' \
    '(-d --debug)'{-d,--debug}'[Debug mode]' \
    '--no-color[No color mode]' \
    '--non-interactive[Run without interactive prompts]' \
    '(-S --scope)'{-S+,--scope=}'[Set a custom scope]:scope:' \
    '(-t --token)'{-t+,--token=}'[Login token]:token:' \
    '1: :_vercel_commands' \
    '*:: :->args' && ret=0

  case $state in
    args)
      local cmd=$words[1]
      # Resolve top-level aliases to their canonical command names.
      case $cmd in
        ls) cmd=list ;;
        rm) cmd=remove ;;
        i) cmd=install ;;
        ir) cmd=integration-resource ;;
        rr) cmd=rolling-release ;;
        cron) cmd=crons ;;
      esac
      case $cmd in
        help)
          (( CURRENT == 2 )) && _vercel_commands && ret=0
          ;;
        env)
          if (( CURRENT == 2 )); then
            _vercel_subcommand env && ret=0
          elif (( CURRENT == 4 )) && [[ $words[2] == (add|remove|update) ]]; then
            _vercel_environments && ret=0
          fi
          ;;
        deploy|dev|link|pull|init)
          if (( CURRENT == 2 )); then
            _files -/ && ret=0
          fi
          ;;
        *)
          if (( CURRENT == 2 )); then
            _vercel_subcommand $cmd && ret=0
          fi
          ;;
      esac
      ;;
  esac

  return ret
}

if [ "$funcstack[1]" = "_vercel" ]; then
  _vercel "$@"
else
  compdef _vercel vercel vc
fi
