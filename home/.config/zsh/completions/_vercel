    ai-gateway)
      subcmds=(
        'api-keys:Manage AI Gateway API keys'
        'budgets:Manage AI Gateway budgets'
        'rules:Manage AI Gateway rules'
        'coding-agents:Manage coding agents'
        'models:List available models'
        'leaderboard:Show model leaderboard'
