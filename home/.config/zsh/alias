# Function (not alias): forwards all arguments, unlike `sh -c claude` which drops them
claude() { op run --no-masking --env-file="$HOME/.claude/op.env" -- claude "$@"; }
alias cp='cp -i'
alias g='git'
alias k='kubectl'
alias l='ls -1A'
alias la='ls -a'
alias ll='ls -lh'
alias ls='ls --color=auto --group-directories-first'
alias mv='mv -i'
alias o='open'
alias rm='rm -i'
alias unic='sort | uniq -c'
