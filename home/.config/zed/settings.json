// Zed settings
//
// For information on how to configure Zed, see the Zed
// documentation: https://zed.dev/docs/configuring-zed
//
// To see all of Zed's default settings without changing your
// custom settings, run `zed: open default settings` from the
// command palette (cmd-shift-p / ctrl-shift-p)
{
  "tab_size": 2,
  "vim": {
    "toggle_relative_line_numbers": false
  },
  "toolbar": {
    "code_actions": false,
    "agent_review": false,
    "selections_menu": true,
    "quick_actions": true,
    "breadcrumbs": true
  },
  "minimap": {
    "show": "never"
  },
  "scrollbar": {
    "show": "system"
  },
  "default_open_behavior": "new_window",
  "telemetry": {
    "diagnostics": false,
    "metrics": false,
    "anthropic_retention": false
  },
  "cli_default_open_behavior": "new_window",
  "which_key": {
    "enabled": true
  },
  "autosave": "on_focus_change",
  "when_closing_with_no_tabs": "platform_default",
  "disable_ai": true,
  "proxy": "",
  "icon_theme": {
    "mode": "dark",
    "light": "Zed (Default)",
    "dark": "Zed (Default)"
  },
  "project_panel": {
    "dock": "left"
  },
  "outline_panel": {
    "dock": "left"
  },
  "collaboration_panel": {
    "dock": "left"
  },
  "agent": {
    "dock": "right",
    "favorite_models": [],
    "model_parameters": []
  },
  "git_panel": {
    "dock": "left"
  },
  "vim_mode": true,
  "base_keymap": "JetBrains",
  "ui_font_size": 16,
  "buffer_font_size": 15,
  "buffer_font_family": "JetBrains Maple Mono",
  "buffer_font_features": {
    "calt": false,
    "liga": false,
    "dlig": false
  },
  "theme": {
    "mode": "dark",
    "light": "One Light",
    "dark": "Ayu Dark",
  },
}
